# Copy this file to .env.local for local development, or set these as
# environment variables in your hosting provider (e.g. Vercel Project
# Settings → Environment Variables) for deployed environments.
#
# See DEPLOYMENT.md for how to obtain each value and which features are
# unavailable when a section is left unset.

# ── App URL ───────────────────────────────────────────────────────────────
# Public base URL of this deployment. Used to build OAuth redirect URIs and
# the audio URLs Twilio fetches for voice calls. On Vercel this can usually
# be left unset in Preview/Production (VERCEL_URL is used as a fallback),
# but should be set explicitly to your production domain once you have one.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Own backend (server/) — auth + business creation ─────────────────────
# See server/.env.example for the backend's own setup. This app only needs
# to know where it is and how to verify its access tokens.
#
# Public URL of the standalone Express API (server/). Local dev default
# matches server/.env.example's PORT.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
# MUST be the exact same value as server/.env.example's JWT_ACCESS_SECRET —
# middleware.ts verifies access tokens the backend signs, so the two sides
# have to share this secret. (JWT_REFRESH_SECRET is never needed here; only
# the backend itself ever verifies a refresh token.)
JWT_ACCESS_SECRET=

# ── Firebase (client SDK) ────────────────────────────────────────────────
# STILL USED for everything except auth/business-creation as of this
# writing — see DEPLOYMENT.md's "Migrating off Firebase" section and
# C:\Users\mhirs\.claude\plans\zippy-beaming-popcorn.md for the phased plan
# to remove this entirely.
# Firebase Console → Project Settings → General → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Set to "true" to point the client SDK at local Firebase emulators.
NEXT_PUBLIC_USE_EMULATORS=false

# ── Firebase Admin SDK (server-only) ─────────────────────────────────────
# Firebase Console → Project Settings → Service Accounts → Generate new
# private key. Required for every API route — without these, Firestore
# reads/writes, auth-token verification, and all webhooks fail closed.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the full PEM key. If your platform stores env vars as a single line,
# keep the literal \n sequences — firebase-admin.ts converts them back to
# real newlines at startup.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Platform admin access ────────────────────────────────────────────────
# Comma-separated email allowlist for platform-admin-only routes (currently
# /api/admin/numbers). Fails CLOSED: leave unset and nobody can use them.
ADMIN_EMAILS=you@example.com,teammate@example.com

# ── Google Gemini (AI responses + booking function-calling) ─────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Twilio (WhatsApp + Voice) ────────────────────────────────────────────
# https://console.twilio.com/ → Account Info (SID/Auth Token), and
# Messaging → Try it out → Send a WhatsApp message (sandbox number), or a
# purchased number for production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Format: whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=

# ── Meta (Messenger + Instagram DMs/comments) ────────────────────────────
# https://developers.facebook.com/ → your App → Settings → Basic (App ID/
# Secret), and Messenger/Instagram → Page-scoped access token.
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
# Arbitrary string you choose; must match the "Verify Token" you enter in
# the Meta webhook configuration UI.
META_VERIFY_TOKEN=
# Required only if you want Instagram DM support in addition to Messenger.
INSTAGRAM_ACCOUNT_ID=
# Set to "true" ONLY for a single-tenant pilot where the Page above is your
# own. It lets a business that has not completed its own Meta OAuth connect
# send as that Page. Leave unset in any multi-tenant deployment: with it on,
# every unconnected business acts as — and can act on behalf of — that one
# Page. Off by default; unconnected businesses are refused instead.
META_ALLOW_SHARED_TOKEN=

# ── Google Calendar (OAuth booking sync) ─────────────────────────────────
# https://console.cloud.google.com/ → APIs & Services → Credentials →
# OAuth client ID (Web application). Add
# {NEXT_PUBLIC_APP_URL}/api/integrations/calendar/callback
# as an authorized redirect URI.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ── ElevenLabs (natural voice for phone calls) ───────────────────────────
# https://elevenlabs.io/app/settings/api-keys
# Optional: without this, the voice webhook falls back to Twilio's built-in
# Polly voices automatically — no code change needed either way.
ELEVENLABS_API_KEY=
# Optional voice ID override; defaults to a bundled voice if unset.
ELEVENLABS_VOICE_ID=

# ── Stripe (billing) ──────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys (use test-mode keys until you're
# ready to charge real cards).
STRIPE_SECRET_KEY=
# https://dashboard.stripe.com/webhooks → Add endpoint →
# {NEXT_PUBLIC_APP_URL}/api/webhooks/stripe → copy the signing secret.
STRIPE_WEBHOOK_SECRET=

# ── Sentry (error monitoring) ────────────────────────────────────────────
# https://sentry.io → Settings → Projects → (your project) → Client Keys
# Optional: without these, Sentry.init() runs as an intentional no-op —
# nothing is sent anywhere, no code change needed either way.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
