# Copy this file to .env.local for local development, or set these as
# environment variables in your hosting provider (e.g. Vercel Project
# Settings → Environment Variables) for deployed environments.
#
# This app is now a pure frontend for the standalone backend in server/ —
# see server/.env.example for everything else (Twilio, Meta, Stripe,
# Gemini, Google Calendar, ElevenLabs, admin allowlist, etc). Firebase has
# been fully removed; there is no longer a Firebase section here.

# ── App URL ───────────────────────────────────────────────────────────────
# Public base URL of this deployment. On Vercel this can usually be left
# unset in Preview/Production (VERCEL_URL is used as a fallback), but
# should be set explicitly to your production domain once you have one.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Own backend (server/) — auth, business data, everything else ─────────
# Public URL of the standalone Express API (server/). Local dev default
# matches server/.env.example's PORT.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
# MUST be the exact same value as server/.env.example's JWT_ACCESS_SECRET —
# middleware.ts verifies access tokens the backend signs, so the two sides
# have to share this secret. (JWT_REFRESH_SECRET is never needed here; only
# the backend itself ever verifies a refresh token.)
JWT_ACCESS_SECRET=

# ── Sentry (error monitoring) ────────────────────────────────────────────
# https://sentry.io → Settings → Projects → (your project) → Client Keys
# Optional: without these, Sentry.init() runs as an intentional no-op —
# nothing is sent anywhere, no code change needed either way.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
