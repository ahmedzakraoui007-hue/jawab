rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user owns or is staff of this business
    function isBusinessMember(businessId) {
      return request.auth != null && (
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/businesses/$(businessId)).data.staffIds
      );
    }
    
    // Users — only the user themselves can read/write their own doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Businesses — authenticated members only
    match /businesses/{businessId} {
      allow read: if request.auth != null && isBusinessMember(businessId);
      // `billing` is never client-writable, on create OR update — it holds
      // real Stripe subscription state, and only the signature-verified
      // Stripe webhook (via the Admin SDK, which bypasses these rules
      // entirely) is allowed to set it. Without this, any signed-in owner
      // could set their own business's billing.status to "active" for a
      // free subscription. A business with no `billing` field is treated
      // as an implicit trial by the app (see src/lib/billing.ts).
      allow create: if request.auth != null && !('billing' in request.resource.data);
      allow update: if request.auth != null && isBusinessMember(businessId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['billing']);
      allow delete: if request.auth != null && isBusinessMember(businessId);
      
      // Conversations subcollection — business members only
      match /conversations/{conversationId} {
        allow read, write: if request.auth != null && isBusinessMember(businessId);
      }
    }
    
    // Bookings — business members only (scoped by the businessId field on
    // each document, since bookings is a top-level collection rather than
    // a subcollection of businesses/{businessId})
    match /bookings/{bookingId} {
      allow read, update, delete: if request.auth != null && isBusinessMember(resource.data.businessId);
      allow create: if request.auth != null && isBusinessMember(request.resource.data.businessId);
    }
  }
}
