# Copy to .env for local development. On Railway (or wherever this is
# deployed), set these as real environment variables instead.

# Postgres connection string. Railway/Neon/Render all give you this
# directly from their dashboard after provisioning a Postgres instance.
DATABASE_URL="postgresql://user:password@localhost:5432/jawab"

# Long random strings — used to sign access and refresh JWTs. Generate
# with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use TWO DIFFERENT values so an access-token leak can't be replayed as a
# refresh token or vice versa.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# The Next.js frontend's origin, for CORS. Comma-separated if you need
# more than one (e.g. local dev + a Vercel preview URL).
FRONTEND_ORIGIN=http://localhost:3000

PORT=4000
# This server's own public URL, once deployed — used to build OAuth
# redirect URIs (Google Calendar, Meta) and the audio URLs Twilio fetches
# for voice calls. Left unset, these fall back to http://localhost:<PORT>,
# which is fine for local dev but must be set for anything OAuth or
# Twilio needs to reach.
BACKEND_PUBLIC_URL=http://localhost:4000

# ── Google Gemini (AI responses + booking function-calling) ─────────────
GEMINI_API_KEY=

# ── Twilio (WhatsApp + Voice) ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Format: whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=

# ── Meta (Messenger + Instagram DMs/comments) ────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# Set to "true" ONLY for a single-tenant pilot where the Page above is
# your own. Off by default — see src/lib/meta.ts's resolveMetaAccessToken.
META_ALLOW_SHARED_TOKEN=

# ── Google OAuth client — Calendar sync AND Google sign-in ───────────────
# One Google Cloud OAuth client, two authorized redirect URIs (add both in
# Google Cloud Console, same client):
# {BACKEND_PUBLIC_URL}/integrations/calendar/callback
# {BACKEND_PUBLIC_URL}/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Phone sign-in (Twilio Verify) ────────────────────────────────────────
# https://console.twilio.com/ → Verify → Services → Create new. Reuses
# TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN above — this is the only extra
# value needed.
TWILIO_VERIFY_SERVICE_SID=

# ── Password reset email (Resend) ────────────────────────────────────────
# https://resend.com/api-keys. Optional: without it, /auth/password/forgot
# still responds 200 (never reveals whether an account exists) but no
# email actually goes out — logged as a warning, not an error.
RESEND_API_KEY=
# Must be a verified sender/domain in Resend. Defaults to Resend's own
# shared test address, which only delivers to the account's own inbox —
# fine for local dev, not for real users.
EMAIL_FROM="Jawab <onboarding@resend.dev>"

# ── ElevenLabs (natural voice for phone calls) ───────────────────────────
# Optional: without this, the voice webhook falls back to Twilio's
# built-in Polly voices automatically.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Stripe (billing) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Webhook endpoint to register: {BACKEND_PUBLIC_URL}/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# ── Platform admin access ────────────────────────────────────────────────
# Comma-separated email allowlist for platform-admin-only routes
# (/admin/*). Fails CLOSED: leave unset and nobody can use them.
ADMIN_EMAILS=you@example.com,teammate@example.com
