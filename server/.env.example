# Copy to .env for local development. On Railway (or wherever this is
# deployed), set these as real environment variables instead.

# Postgres connection string. Railway/Neon/Render all give you this
# directly from their dashboard after provisioning a Postgres instance.
DATABASE_URL="postgresql://user:password@localhost:5432/jawab"

# Long random strings — used to sign access and refresh JWTs. Generate
# with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use TWO DIFFERENT values so an access-token leak can't be replayed as a
# refresh token or vice versa.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# The Next.js frontend's origin, for CORS. Comma-separated if you need
# more than one (e.g. local dev + a Vercel preview URL).
FRONTEND_ORIGIN=http://localhost:3000

PORT=4000
